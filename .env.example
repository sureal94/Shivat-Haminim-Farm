# Public site URL used for canonical and Open Graph tags
VITE_SITE_URL=https://www.example.com

# Real donation / payment destination. Leave empty until a provider is connected.
# Examples: a Wix donate page, PayPal.me, IsraelGives, JGive, or Stripe Payment Link
VITE_DONATION_URL=

# Optional contact form backend (Formspree, Getform, custom API).
# Forms always also open a message to shivat.haminim.farm@gmail.com.
VITE_CONTACT_ENDPOINT=
